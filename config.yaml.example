# Daily Greeting — Behavioral Configuration
# Copy to config.yaml and mount at /config/config.yaml
#
# Infrastructure settings (URLs, credentials, coordinates) belong in .env,
# not here. See .env.example for the full list.

# Options for the weather.gov API
weather:
  user_agent: DailyGreeting/0.4.0
  # lat/lon: set via GREETING_WEATHER_LAT / GREETING_WEATHER_LON

# Options for the Ollama API
ollama:
  # host: set via GREETING_OLLAMA_HOST
  text_model: mistral:7b        # Model for text-only requests
  multimodal_model: llava:7b    # Model for cover art analysis

# Options for the Subsonic API
navidrome:
  # URL, username, password: set via GREETING_NAVIDROME_URL / _USER / _PASS
  client_name: DailyGreeting

# Target greeting length in word count, drawn from a lognormal distribution
greeting:
  min_length: 50    # Minimum cutoff
  q1_length: 100    # First quartile
  mean_length: 140  # Mean

# Options for literature excerpt selection
literature:
  length: 600    # Excerpt length in characters
  padding: 2000  # Characters stripped from front/end of book to remove front/end matter

# Options for TTS generation with Piper
piper:
  voice: random       # Piper TTS model name, or "random" to pick from available voices
  length_scale: 1.15  # Slowed down for better comprehension when waking up
  noise_scale: 0.667
  noise_w_scale: 0.8
