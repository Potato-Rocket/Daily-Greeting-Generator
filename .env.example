# Daily Greeting — Infrastructure & Secrets
# Copy to .env and fill in your values.
#
# These override config.yaml. Behavioral tuning (model names, excerpt lengths,
# TTS parameters) lives in config.yaml instead — see config.yaml.example.

# --- Paths (usually only needed for local dev; Docker sets these via compose.yml) ---
GREETING_BASE_DIR=/
GREETING_CONFIG_DIR=/config/

# --- Location (required for weather.gov API) ---
GREETING_WEATHER_LAT=0.0
GREETING_WEATHER_LON=0.0

# --- Ollama ---
GREETING_OLLAMA_HOST=http://localhost:11434

# --- Navidrome (Subsonic API) ---
GREETING_NAVIDROME_URL=http://localhost:4533
GREETING_NAVIDROME_USER=username
GREETING_NAVIDROME_PASS=password

# --- Log level (default: INFO) ---
LOG_LEVEL=INFO
