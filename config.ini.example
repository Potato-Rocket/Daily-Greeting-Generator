# Daily Greeting Configuration
# Copy this file to config.ini and customize for your environment
# config.ini is gitignored and won't be committed

# weather.gov API setup
[weather]
lat = 0.00
lon = 0.00
user_agent = DailyGreeting/1.0

# Ollama server configuration
[ollama]
base_url = http://localhost:11434
model = mistral:7b
image_model = llava:7b

# Navidrome/Subsonic API configuration
[navidrome]
base_url = http://localhost:4533
username = username
password = password
client_name = DailyGreeting

# Piper TTS configuration
# voice: model stem name, or "random" to pick from available models
# length_scale: >1.0 = slower speech, <1.0 = faster
[piper]
voice = random
length_scale = 1.15
noise_scale = 0.667
noise_w_scale = 0.8

# Literature excerpt parameters
[literature]
length = 600
padding = 2000
